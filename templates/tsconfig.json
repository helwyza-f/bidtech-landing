{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@/*": ["./_boilerplate/*"],
      "@app-types/*": ["./organization/template-2/src/types/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "_boilerplate/**/*.ts",
    "_boilerplate/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/.next", "**/out"]
}
