# Domain produksi (dipakai untuk metadataBase, canonical, sitemap, robots, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://hktikotabatam.org

# Google Analytics 4 Measurement ID (contoh: G-XXXXXXXXXX)
# Kosongkan untuk menonaktifkan analytics sepenuhnya — tidak ada script yang dimuat.
NEXT_PUBLIC_GA_ID=

# Kode verifikasi Google Search Console (meta tag "google-site-verification")
NEXT_PUBLIC_GSC_VERIFICATION=

# Kode verifikasi Bing Webmaster Tools (meta tag "msvalidate.01")
NEXT_PUBLIC_BING_VERIFICATION=
