# Contoh konfigurasi nginx DI HOST VPS (bukan di dalam container) untuk
# hktikotabatam.org. TLS di-terminate di sini karena Cloudflare diset ke
# "Full (Strict)" — VPS wajib punya sertifikat valid sendiri (mis. certbot).
#
# Salin ke /etc/nginx/sites-available/hktikotabatam.org.conf lalu:
#   ln -s /etc/nginx/sites-available/hktikotabatam.org.conf /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# Sesuaikan domain kanonik: kalau ingin "www" jadi kanonik, tukar arah
# redirect di blok :443 di bawah (atau atur di Cloudflare Redirect Rules).

upstream hkti_batam {
    server 127.0.0.1:3020;
    keepalive 32;
}

# HTTP: redirect ke HTTPS, kecuali path challenge certbot
server {
    listen 80;
    listen [::]:80;
    server_name hktikotabatam.org www.hktikotabatam.org;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: terminate TLS, reverse-proxy ke container Docker di port 3020
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hktikotabatam.org www.hktikotabatam.org;

    ssl_certificate     /etc/letsencrypt/live/hktikotabatam.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hktikotabatam.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 10m;

    location / {
        proxy_pass http://hkti_batam;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}
